<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Para mi amor ❤️</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html,
body{
    width:100%;
    height:100%;
}

body{
    overflow:hidden;
    font-family:Georgia, "Times New Roman", serif;
    color:#573444;

    background:
        radial-gradient(circle at 20% 20%, rgba(255,255,255,.9), transparent 30%),
        radial-gradient(circle at 80% 80%, rgba(177,226,255,.45), transparent 35%),
        linear-gradient(
            135deg,
            #fce4ed 0%,
            #fae8ef 35%,
            #e7f4fa 70%,
            #d9eff8 100%
        );
}


/* ==================================================
   FONDO
================================================== */

.background-light{
    position:fixed;
    inset:0;
    overflow:hidden;
    pointer-events:none;
    z-index:0;
}

.light{
    position:absolute;
    border-radius:50%;
    filter:blur(90px);
    opacity:.3;

    animation:
        moveLight
        12s
        ease-in-out
        infinite
        alternate;
}

.light.one{
    width:400px;
    height:400px;

    left:-120px;
    top:5%;

    background:#ffaccb;
}

.light.two{
    width:450px;
    height:450px;

    right:-130px;
    bottom:-50px;

    background:#9eddf7;

    animation-delay:-5s;
}

@keyframes moveLight{

    from{
        transform:
            translate(0,0)
            scale(1);
    }

    to{
        transform:
            translate(45px,-30px)
            scale(1.15);
    }
}


/* ==================================================
   PÉTALOS
================================================== */

#petals{
    position:fixed;
    inset:0;

    overflow:hidden;
    pointer-events:none;

    z-index:2;
}

.petal{
    position:absolute;

    top:-60px;

    width:16px;
    height:24px;

    border-radius:
        75% 20%
        70% 30%;

    transform-origin:center;

    box-shadow:
        inset -3px -3px 5px rgba(100,50,70,.08),
        inset 2px 2px 5px rgba(255,255,255,.6),
        0 3px 7px rgba(80,50,70,.07);

    animation:
        petalFall
        linear
        forwards;
}

.petal::after{

    content:"";

    position:absolute;

    width:1px;
    height:65%;

    left:50%;
    top:18%;

    background:
        rgba(255,255,255,.35);

    transform:
        rotate(-8deg);
}


@keyframes petalFall{

    0%{

        transform:
            translate3d(0,-50px,0)
            rotateX(0deg)
            rotateY(0deg)
            rotateZ(0deg);

        opacity:0;
    }

    10%{
        opacity:.75;
    }

    25%{

        transform:
            translate3d(35px,25vh,0)
            rotateX(100deg)
            rotateY(60deg)
            rotateZ(90deg);
    }

    50%{

        transform:
            translate3d(-30px,50vh,0)
            rotateX(200deg)
            rotateY(120deg)
            rotateZ(180deg);
    }

    75%{

        transform:
            translate3d(45px,78vh,0)
            rotateX(300deg)
            rotateY(180deg)
            rotateZ(270deg);
    }

    100%{

        transform:
            translate3d(-25px,110vh,0)
            rotateX(420deg)
            rotateY(240deg)
            rotateZ(400deg);

        opacity:.1;
    }
}


/* ==================================================
   PANTALLAS
================================================== */

.screen{
    position:fixed;
    inset:0;

    display:flex;

    align-items:center;
    justify-content:center;

    flex-direction:column;

    text-align:center;

    padding:25px;

    z-index:10;
}


/* ==================================================
   INICIO
================================================== */

#startScreen{

    transition:
        opacity .8s ease,
        transform .8s ease,
        filter .8s ease;
}

.smallText{

    margin-bottom:25px;

    font-size:14px;

    letter-spacing:5px;

    text-transform:uppercase;

    color:#936075;

    opacity:.8;
}


#openButton{

    padding:19px 55px;

    border:
        1px solid
        rgba(255,255,255,.8);

    border-radius:50px;

    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,.82),
            rgba(255,255,255,.42)
        );

    backdrop-filter:
        blur(14px);

    color:#914c69;

    font-family:
        Georgia,
        serif;

    font-size:21px;

    letter-spacing:5px;

    cursor:pointer;

    box-shadow:
        0 22px 45px rgba(102,54,75,.13),
        0 5px 15px rgba(102,54,75,.08),
        inset 0 1px 1px rgba(255,255,255,.95);

    transition:
        transform .3s ease,
        box-shadow .3s ease;
}

#openButton:hover{

    transform:
        translateY(-3px)
        scale(1.05);

    box-shadow:
        0 28px 60px rgba(102,54,75,.18),
        0 8px 20px rgba(102,54,75,.1);
}


/* ==================================================
   CUMPLEAÑOS
================================================== */

#mainContent{

    display:none;

    opacity:0;

    transition:
        opacity 1s ease;
}


.birthday{

    max-width:950px;

    font-size:
        clamp(
            36px,
            6vw,
            75px
        );

    line-height:1.08;

    font-weight:normal;

    color:#9e4667;

    text-shadow:
        0 2px 0 rgba(255,255,255,.85),
        0 8px 25px rgba(125,54,83,.13);

    animation:
        titleAppear
        1.5s
        cubic-bezier(.2,.8,.2,1);
}


@keyframes titleAppear{

    from{

        opacity:0;

        transform:
            translateY(25px)
            scale(.94);

        filter:
            blur(7px);
    }

    to{

        opacity:1;

        transform:
            translateY(0)
            scale(1);

        filter:
            blur(0);
    }
}


/* ==================================================
   CORAZÓN
================================================== */

.mainHeart{

    margin-top:18px;

    font-size:45px;

    filter:
        drop-shadow(
            0 5px 8px
            rgba(180,50,90,.2)
        );

    animation:
        heartbeat
        1.4s
        infinite;
}


@keyframes heartbeat{

    0%,
    100%{
        transform:scale(1);
    }

    10%{
        transform:scale(1.15);
    }

    20%{
        transform:scale(1);
    }

    30%{
        transform:scale(1.1);
    }

    45%{
        transform:scale(1);
    }
}


/* ==================================================
   PREGUNTA
================================================== */

#question{

    margin-top:40px;

    opacity:0;

    transform:
        translateY(20px);

    pointer-events:none;

    transition:
        opacity 1s ease,
        transform 1s ease;
}


#question.show{

    opacity:1;

    transform:
        translateY(0);

    pointer-events:auto;
}


#question h2{

    font-size:
        clamp(
            27px,
            4vw,
            42px
        );

    font-weight:normal;

    margin-bottom:25px;

    color:#644051;
}


.buttons{

    display:flex;

    align-items:center;
    justify-content:center;

    gap:25px;

    min-height:70px;
}


.loveButton{

    width:130px;
    height:55px;

    border:none;

    border-radius:30px;

    font-family:
        Georgia,
        serif;

    font-size:19px;

    cursor:pointer;

    user-select:none;
}


/* ==================================================
   SÍ
================================================== */

#yesButton{

    color:white;

    background:
        linear-gradient(
            135deg,
            #f58cb3,
            #e96f9c
        );

    box-shadow:
        0 10px 25px rgba(210,80,130,.25),
        inset 0 1px 1px rgba(255,255,255,.4);

    transition:
        transform .25s,
        box-shadow .25s;
}


#yesButton:hover{

    transform:
        translateY(-3px)
        scale(1.06);

    box-shadow:
        0 15px 30px
        rgba(210,80,130,.32);
}


/* ==================================================
   NO ORIGINAL
================================================== */

#noButton{

    color:#416a7c;

    background:
        linear-gradient(
            135deg,
            #c2e9fa,
            #9fd7ef
        );

    box-shadow:
        0 10px 25px
        rgba(70,140,170,.18);

    transition:
        transform .15s ease;
}


/* ==================================================
   CAPA ESPECIAL PARA EL BOTÓN NO

   ESTA CAPA OCUPA EXACTAMENTE LA PANTALLA.
================================================== */

#noLayer{

    position:fixed;

    left:0;
    top:0;

    width:100vw;
    height:100vh;

    pointer-events:none;

    overflow:hidden;

    z-index:80;

    display:none;
}


/* Cuando NO entra acá */

#noLayer #noButton{

    position:absolute;

    left:0;
    top:0;

    pointer-events:auto;

    margin:0;

    /*
       IMPORTANTE:

       NO hacemos transición de left/top.

       Esto elimina el bug donde Chrome
       interpolaba posiciones raras.
    */

    transition:
        transform .15s ease;
}


/* ==================================================
   CARTA
================================================== */

#letterOverlay{

    position:fixed;

    inset:0;

    z-index:100;

    display:none;

    align-items:center;
    justify-content:center;

    padding:
        30px
        20px;

    background:
        rgba(55,30,40,.30);

    backdrop-filter:
        blur(10px);

    opacity:0;

    transition:
        opacity .8s ease;
}


#letterOverlay.show{
    opacity:1;
}


.letterContainer{

    width:
        min(
            720px,
            calc(100vw - 40px)
        );

    /*
       Dejamos espacio arriba
       y abajo.
    */

    max-height:
        calc(100vh - 60px);

    opacity:0;

    transform:
        translateY(25px)
        scale(.95);

    transition:
        transform 1s cubic-bezier(.2,.8,.2,1),
        opacity 1s ease;
}


#letterOverlay.show
.letterContainer{

    opacity:1;

    transform:
        translateY(0)
        scale(1);
}


.letter{

    position:relative;

    width:100%;

    max-height:
        calc(100vh - 60px);

    overflow-y:auto;
    overflow-x:hidden;

    padding:
        65px
        65px
        75px
        60px;

    text-align:left;

    color:#52382d;


    background:

        radial-gradient(
            circle at 15% 15%,
            rgba(255,255,255,.5),
            transparent 25%
        ),

        radial-gradient(
            circle at 90% 80%,
            rgba(135,86,44,.10),
            transparent 30%
        ),

        linear-gradient(
            135deg,
            #fff5d9,
            #f6e5bc 55%,
            #efdaa9
        );


    border:
        1px solid
        rgba(105,67,39,.18);

    border-radius:5px;


    box-shadow:

        0 35px 80px
        rgba(45,25,20,.30),

        0 15px 30px
        rgba(45,25,20,.18),

        inset 0 0 55px
        rgba(120,80,40,.10);
}


/* Borde interior */

.letter::before{

    content:"";

    position:absolute;

    inset:14px;

    border:
        1px solid
        rgba(115,75,45,.18);

    pointer-events:none;
}


/* Textura */

.letter::after{

    content:"";

    position:absolute;

    inset:0;

    pointer-events:none;

    opacity:.12;

    background-image:

        repeating-linear-gradient(
            0deg,
            transparent,
            transparent 3px,
            rgba(90,60,30,.05) 4px
        );
}


.letter h1{

    position:relative;

    z-index:2;

    text-align:center;

    margin-bottom:35px;

    font-size:
        clamp(
            28px,
            5vw,
            40px
        );

    font-weight:normal;

    color:#704838;
}


.letter p{

    position:relative;

    z-index:2;

    margin-bottom:22px;

    font-size:18px;

    line-height:1.85;
}


/* ==================================================
   SCROLL CARTA
================================================== */

.letter::-webkit-scrollbar{

    width:8px;
}


.letter::-webkit-scrollbar-track{

    background:
        rgba(100,70,40,.07);

    border-radius:20px;
}


.letter::-webkit-scrollbar-thumb{

    background:
        rgba(105,72,50,.32);

    border-radius:20px;
}


.letter::-webkit-scrollbar-thumb:hover{

    background:
        rgba(105,72,50,.5);
}


/* ==================================================
   CERRAR CARTA
================================================== */

.closeLetter{

    position:absolute;

    top:23px;
    right:27px;

    z-index:10;

    width:36px;
    height:36px;

    border:none;

    border-radius:50%;

    background:
        rgba(110,75,50,.08);

    color:#6c4939;

    font-size:19px;

    cursor:pointer;

    transition:.2s;
}


.closeLetter:hover{

    background:
        rgba(110,75,50,.16);

    transform:
        scale(1.08);
}


/* ==================================================
   EXPLOSIÓN DE CORAZONES
================================================== */

.floatingHeart{

    position:fixed;

    left:50%;
    top:50%;

    z-index:200;

    pointer-events:none;

    font-size:25px;

    animation:
        heartExplosion
        2.2s
        ease-out
        forwards;
}


@keyframes heartExplosion{

    from{

        opacity:1;

        transform:
            translate(-50%,-50%)
            scale(.5);
    }

    to{

        opacity:0;

        transform:
            translate(
                var(--x),
                var(--y)
            )
            scale(1.7)
            rotate(
                var(--rotation)
            );
    }
}


/* ==================================================
   CELULAR
================================================== */

@media(max-width:600px){

    .screen{
        padding:18px;
    }

    .birthday{

        font-size:
            clamp(
                32px,
                10vw,
                43px
            );
    }

    #question{
        margin-top:30px;
    }

    .buttons{
        gap:15px;
    }

    .loveButton{

        width:105px;
        height:50px;

        font-size:17px;
    }

    .letterContainer{

        width:
            calc(100vw - 24px);

        max-height:
            calc(100vh - 24px);
    }

    .letter{

        max-height:
            calc(100vh - 24px);

        padding:
            58px
            30px
            60px
            27px;
    }

    .letter p{

        font-size:16.5px;

        line-height:1.75;
    }
}

</style>
</head>


<body>


<!-- FONDO -->

<div class="background-light">

    <div class="light one"></div>

    <div class="light two"></div>

</div>


<!-- PÉTALOS -->

<div id="petals"></div>


<!--
    ESTA CAPA SE USA PARA MOVER
    EL BOTÓN NO SIN QUE PUEDA
    SALIR DE LA PANTALLA
-->

<div id="noLayer"></div>


<!-- ==================================================
     INICIO
================================================== -->

<div
    class="screen"
    id="startScreen"
>

    <div class="smallText">

        Tengo algo para vos...

    </div>


    <button id="openButton">

        ABRIR

    </button>

</div>


<!-- ==================================================
     PRINCIPAL
================================================== -->

<div
    class="screen"
    id="mainContent"
>

    <h1 class="birthday">

        FELIZ CUMPLEAÑOOOOOS

        <br>

        MI AMOOOORRR

    </h1>


    <div class="mainHeart">

        ❤️

    </div>


    <div id="question">


        <h2>

            ¿Me amás? 🥺❤️

        </h2>


        <div class="buttons">


            <button
                class="loveButton"
                id="yesButton"
            >

                SÍ ❤️

            </button>


            <button
                class="loveButton"
                id="noButton"
            >

                NO 😒

            </button>


        </div>

    </div>

</div>


<!-- ==================================================
     CARTA
================================================== -->

<div id="letterOverlay">


    <div class="letterContainer">


        <div class="letter">


            <button
                class="closeLetter"
                id="closeLetter"
            >

                ✕

            </button>


            <h1>

                Para el amor de mi vida ❤️

            </h1>


            <p>
                Mi amor, hoy es un día demasiado especial para mí,
                porque hoy cumple años una de las personas más hermosa
                que llegó a mi vida.
            </p>


            <p>
                Quería hacerte algo diferente, algo que cuando lo
                vieras supieras que me senté a pensar en vos (bueno cuando no pienso en vos JAJAJA). 
                Quería hacer algo que me haga pensar
                en lo que te gusta, en cómo sacarte una sonrisa
                y en cómo hacer que aunque sea por unos minutos
                te sientas la persona más especial del mundo.
            </p>


            <p>
                Desde que llegaste a mi vida hay muchísimas cosas
                que cambiaron. Hay momentos normales que se vuelven
                especiales simplemente porque estás vos.
                Una llamada, un mensaje, una risa, una boludez que
                solamente nosotros nos reimos. son cosas que capaz
                parecen pequeñas, pero para mí significan muchísimo.
            </p>


            <p>
                Me encanta poder conocerte cada día un poquito más.
                Conocer tus gustos, las cosas que te hacen
                feliz, las que te enojan, tus sueños, tus inseguridades,
                tus momentos buenos y también esos días donde no todo
                sale como queremos.
            </p>


            <p>
                Y quiero que sepas algo: no quiero estar solamente
                para tus días lindos. Quiero estar también cuando
                tengas un día de mierda, cuando estés cansada,
                cuando estés enojada con el mundo o cuando simplemente
                necesites a alguien al lado sin tener que hablar nada.
            </p>


            <p>
                No sé qué nos va a traer la vida, porque nadie puede
                saberlo. Pero sí sé lo que quiero hacer hoy:
                disfrutar cada momento al lado tuyo, cuidarte, hacerte reír, 
                estar a tu lado y seguir creando recuerdos con vos.
            </p>


            <p>
                Quiero poder verte darte cuenta de lo increíble que podés llegar
                a ser. Y si alguna vez te olvidás de eso,
                voy a estar yo para recordártelo todas las veces necesarias.
            </p>


            <p>
                Gracias por cada momento, por cada mensaje,
                por cada llamada, por cada risa y hasta por esas
                pequeñas discusiones.
            </p>


            <p>
                Gracias por ser vos y solamente vos.
            </p>


            <p>
                Hoy solamente quiero que disfrutes muchísimo tu día 
                y que recuerdes que hay una persona
                acá que está extremadamente feliz
                de haberte conocido.
            </p>


            <p>
                Y sí. después de hacer toda esta página solamente
                para preguntarte si me amás, espero que hayas
                apretado que sí porque claramente el botón NO
                no te iba a dejar jajajaja.
            </p>


            <p>
                Feliz cumpleaños, mi amor.
                Espero poder compartir muchísimos cumpleaños más
                con vos, seguir conociendote mas con cada dia que pasa
                y algún día poder mirar a esos 
                ojos hermosos que no me los puedo olvidar nunca.


            <p>
                Te amo muchísimo. Más de lo que probablemente
                pueda explicar en una carta, en una página
                o en cualquier regalo posible. ❤️
            </p>


        </div>

    </div>

</div>


<script>


/* ==================================================
   PÉTALOS
================================================== */

const petalsContainer =
    document.getElementById("petals");


function createPetal(){

    const petal =
        document.createElement("div");

    petal.classList.add("petal");


    const colors = [

        "linear-gradient(135deg,#ffc1d7,#ed91b5)",

        "linear-gradient(135deg,#ffd8e5,#f2abc4)",

        "linear-gradient(135deg,#c5ecff,#8fd4f1)",

        "linear-gradient(135deg,#def5ff,#a7dff5)"

    ];


    petal.style.background =

        colors[
            Math.floor(
                Math.random()
                *
                colors.length
            )
        ];


    petal.style.left =

        Math.random()
        *
        100
        +
        "vw";


    const size =

        10
        +
        Math.random()
        *
        11;


    petal.style.width =
        size + "px";


    petal.style.height =
        size * 1.45 + "px";


    petal.style.opacity =

        .45
        +
        Math.random()
        *
        .4;


    const duration =

        7
        +
        Math.random()
        *
        7;


    petal.style.animationDuration =

        duration + "s";


    petalsContainer.appendChild(
        petal
    );


    setTimeout(
        ()=>{
            petal.remove();
        },
        duration * 1000
    );
}


setInterval(
    createPetal,
    300
);



/* ==================================================
   ABRIR
================================================== */

const openButton =
    document.getElementById("openButton");

const startScreen =
    document.getElementById("startScreen");

const mainContent =
    document.getElementById("mainContent");

const question =
    document.getElementById("question");


openButton.addEventListener(
    "click",
    ()=>{

        startScreen.style.opacity =
            "0";

        startScreen.style.transform =
            "scale(1.06)";

        startScreen.style.filter =
            "blur(5px)";


        setTimeout(
            ()=>{

                startScreen.style.display =
                    "none";

                mainContent.style.display =
                    "flex";


                setTimeout(
                    ()=>{

                        mainContent.style.opacity =
                            "1";

                    },
                    50
                );


                setTimeout(
                    ()=>{

                        question.classList.add(
                            "show"
                        );

                    },
                    3000
                );

            },
            800
        );

    }
);



/* ==================================================
   BOTÓN NO
================================================== */

const noButton =
    document.getElementById("noButton");

const noLayer =
    document.getElementById("noLayer");


let noHasMoved = false;


/*
   ESTA ES LA PARTE IMPORTANTE.

   El botón NO se mueve con coordenadas
   ambiguas dentro de otros elementos.

   Primero lo sacamos completamente del
   diseño y lo ponemos dentro de una capa
   que mide EXACTAMENTE lo mismo que la
   pantalla.
*/

function moveNoButton(){


    /*
       PRIMER CLICK

       Guardamos dónde estaba visualmente.
    */

    if(!noHasMoved){


        const rect =
            noButton.getBoundingClientRect();


        /*
           Mostramos la capa.
        */

        noLayer.style.display =
            "block";


        /*
           Movemos físicamente el botón
           dentro de esa capa.
        */

        noLayer.appendChild(
            noButton
        );


        /*
           Lo ponemos inicialmente
           exactamente donde estaba.

           Así no desaparece ni salta
           antes de calcular.
        */

        noButton.style.left =
            rect.left + "px";

        noButton.style.top =
            rect.top + "px";


        noHasMoved = true;

    }


    /*
       Margen GRANDE de seguridad.

       El botón nunca puede acercarse
       más de 35px a ningún borde.
    */

    const margin = 35;


    /*
       Tamaño REAL del botón.
    */

    const buttonWidth =
        noButton.getBoundingClientRect().width;

    const buttonHeight =
        noButton.getBoundingClientRect().height;


    /*
       Usamos documentElement.clientWidth
       en vez de innerWidth.

       Esto evita problemas con scrollbar,
       zoom y tamaño real del viewport.
    */

    const screenWidth =
        document.documentElement.clientWidth;

    const screenHeight =
        document.documentElement.clientHeight;


    /*
       Coordenada máxima.

       EJEMPLO:

       Pantalla = 1360
       Botón = 130
       Margen = 35

       Máximo:
       1360 - 130 - 35 = 1195

       Así el botón jamás puede pasar
       de ese punto.
    */

    const maxX =
        screenWidth
        -
        buttonWidth
        -
        margin;


    const maxY =
        screenHeight
        -
        buttonHeight
        -
        margin;


    /*
       Posición actual.
    */

    const current =
        noButton.getBoundingClientRect();


    let x;
    let y;

    let attempts = 0;


    /*
       Generamos lugares aleatorios.

       Intentamos que el nuevo lugar
       esté mínimo a 200px del anterior.
    */

    do{


        x =
            margin
            +
            Math.random()
            *
            Math.max(
                0,
                maxX - margin
            );


        y =
            margin
            +
            Math.random()
            *
            Math.max(
                0,
                maxY - margin
            );


        attempts++;


    }while(

        Math.hypot(
            x - current.left,
            y - current.top
        )
        <
        200

        &&

        attempts < 50

    );


    /*
       SEGURIDAD FINAL.

       Incluso aunque Math.random
       o cualquier cálculo diese
       algo extraño, lo encerramos
       entre los límites.
    */

    x =
        Math.min(
            Math.max(
                x,
                margin
            ),
            maxX
        );


    y =
        Math.min(
            Math.max(
                y,
                margin
            ),
            maxY
        );


    /*
       POSICIÓN FINAL.
    */

    noButton.style.left =
        Math.round(x)
        +
        "px";


    noButton.style.top =
        Math.round(y)
        +
        "px";

}



/*
   PC

   Solo cuando INTENTA hacer click.
*/

noButton.addEventListener(
    "pointerdown",
    (event)=>{

        event.preventDefault();

        event.stopPropagation();

        moveNoButton();

    }
);



/*
   Bloqueamos el click real.
*/

noButton.addEventListener(
    "click",
    (event)=>{

        event.preventDefault();

        event.stopPropagation();

    }
);



/* ==================================================
   SI CAMBIA EL TAMAÑO DE PANTALLA
================================================== */

window.addEventListener(
    "resize",
    ()=>{

        if(!noHasMoved){
            return;
        }


        const margin =
            35;


        const rect =
            noButton.getBoundingClientRect();


        const width =
            document.documentElement.clientWidth;


        const height =
            document.documentElement.clientHeight;


        const maxX =
            width
            -
            rect.width
            -
            margin;


        const maxY =
            height
            -
            rect.height
            -
            margin;


        let x =
            parseFloat(
                noButton.style.left
            )
            ||
            margin;


        let y =
            parseFloat(
                noButton.style.top
            )
            ||
            margin;


        x =
            Math.max(
                margin,
                Math.min(
                    x,
                    maxX
                )
            );


        y =
            Math.max(
                margin,
                Math.min(
                    y,
                    maxY
                )
            );


        noButton.style.left =
            x + "px";


        noButton.style.top =
            y + "px";

    }
);



/* ==================================================
   BOTÓN SÍ
================================================== */

const yesButton =
    document.getElementById("yesButton");

const letterOverlay =
    document.getElementById("letterOverlay");


yesButton.addEventListener(
    "click",
    ()=>{


        createHearts();


        setTimeout(
            ()=>{


                letterOverlay.style.display =
                    "flex";


                setTimeout(
                    ()=>{

                        letterOverlay.classList.add(
                            "show"
                        );

                    },
                    40
                );


            },
            400
        );

    }
);



/* ==================================================
   CORAZONES
================================================== */

function createHearts(){


    const emojis = [

        "❤️",
        "🩷",
        "💕",
        "💗",
        "💖",
        "🩵"

    ];


    for(
        let i = 0;
        i < 32;
        i++
    ){


        const heart =
            document.createElement(
                "div"
            );


        heart.classList.add(
            "floatingHeart"
        );


        heart.textContent =

            emojis[
                Math.floor(
                    Math.random()
                    *
                    emojis.length
                )
            ];


        const x =

            (
                Math.random()
                -
                .5
            )
            *
            750;


        const y =

            (
                Math.random()
                -
                .5
            )
            *
            650;


        const rotation =

            (
                Math.random()
                *
                100
                -
                50
            )
            +
            "deg";


        heart.style.setProperty(
            "--x",
            x + "px"
        );


        heart.style.setProperty(
            "--y",
            y + "px"
        );


        heart.style.setProperty(
            "--rotation",
            rotation
        );


        document.body.appendChild(
            heart
        );


        setTimeout(
            ()=>{
                heart.remove();
            },
            2300
        );

    }

}



/* ==================================================
   CERRAR CARTA
================================================== */

const closeLetter =
    document.getElementById(
        "closeLetter"
    );


closeLetter.addEventListener(
    "click",
    ()=>{


        letterOverlay.classList.remove(
            "show"
        );


        setTimeout(
            ()=>{

                letterOverlay.style.display =
                    "none";

            },
            800
        );

    }
);


</script>

</body>
</html>